---
import { Image } from 'astro:assets'
import icon from '../assets/icon.png'
---

<div class="stack">
	<main class="card">
		<Image
			class="avatar"
			src={icon}
			alt="アイコン"
			width={120}
			height={120}
			widths={[120, 240, 360]}
			loading="eager"
			priority
		/>
		<h1 class="name">おーたかこーたろー</h1>
		<p class="handle">@otakakot</p>

		<nav class="links" aria-label="SNSリンク">
			<a class="link" href="https://x.com/otakakot" target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
					></path>
				</svg>
				<span>X（Twitter）</span>
			</a>
			<a class="link" href="https://github.com/otakakot" target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
					></path>
				</svg>
				<span>GitHub</span>
			</a>
		</nav>
	</main>
	<p class="credit">
		The <a href="https://go.dev/blog/gopher" target="_blank" rel="noopener noreferrer">Go gopher</a> was
		designed by <a href="https://reneefrench.blogspot.com/" target="_blank" rel="noopener noreferrer">Renée
			French</a>.
	</p>
</div>

<style>
	.stack {
		position: relative;
	}

	.card {
		width: 100%;
		max-width: 420px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 32px;
		box-shadow:
			0 20px 50px rgba(74, 118, 145, 0.18),
			0 6px 16px rgba(74, 118, 145, 0.08);
		padding: 48px 36px 40px;
		text-align: center;
	}

	.avatar {
		display: block;
		width: 120px;
		height: 120px;
		object-fit: cover;
		border-radius: 50%;
		margin: 0 auto 20px;
	}

	.name {
		font-size: 26px;
		font-weight: 700;
		margin: 0 0 4px;
		letter-spacing: -0.5px;
	}

	.handle {
		font-size: 14px;
		color: var(--muted);
		margin: 0 0 28px;
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 0;
		padding: 0;
	}

	.link {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 18px;
		background: var(--soft);
		border: 1px solid var(--border);
		border-radius: 14px;
		font-size: 15px;
		font-weight: 600;
		color: var(--text);
		text-align: left;
		transition:
			transform 0.1s,
			border-color 0.2s,
			background 0.2s;
	}

	.link:hover {
		background: var(--card);
		border-color: var(--primary);
	}

	.link:active {
		transform: scale(0.98);
	}

	.link svg {
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		color: var(--primary);
	}

	.credit {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		margin-top: 16px;
		font-size: 11px;
		color: var(--muted);
		text-align: center;
	}

	.credit a {
		color: var(--muted);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.credit a:hover {
		color: var(--primary);
	}
</style>
